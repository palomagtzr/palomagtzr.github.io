---
const groups = [
  { title: 'Frontend', items: ['TypeScript', 'React', 'Next.js', 'React Native', 'Tailwind CSS'] },
  { title: 'Backend & data', items: ['Supabase', 'PostgreSQL', 'Stripe', 'PHP', 'Python'] },
  { title: 'Design', items: ['Figma', 'Adobe Photoshop', 'Adobe Illustrator', 'Design systems'] },
  { title: 'Product & ops', items: ['Notion', 'Azure DevOps', 'Odoo', 'Google Workspace', 'Claude Code'] },
];
---
<section id="toolkit" class="container-x pt-10 pb-24 sm:pb-[120px] flex flex-wrap gap-10 sm:gap-14" aria-labelledby="toolkit-title" data-toolkit>
  <h2 id="toolkit-title" class="m-0 flex-[1_1_300px] display text-[clamp(2.6rem,5vw,4.6rem)] tracking-[-0.045em] leading-[0.95]">Toolkit</h2>
  <div class="flex-[2_1_560px] min-w-0 flex flex-wrap gap-x-12 gap-y-10">
    {groups.map((g) => (
      <div class="flex-[1_1_240px] flex flex-col gap-3" data-toolkit-group>
        <h3 class="m-0 relative label font-normal tracking-[0.08em] text-ink-3 pb-2.5">
          {g.title}
          <span class="absolute left-0 right-0 bottom-0 h-[1.5px] bg-ink origin-left" aria-hidden="true" data-rule></span>
        </h3>
        <ul class="m-0 p-0 list-none text-[20px] leading-[1.6] font-medium">
          {g.items.map((item) => <li data-tool>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

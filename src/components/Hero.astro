---
import { Image } from 'astro:assets';
import DropLogo from './DropLogo.astro';
import Drip from './Drip.astro';
import photo from '../assets/photo.jpg';
---
<section class="container-x pt-10 pb-20 sm:pt-14 sm:pb-24 flex flex-wrap items-end gap-10 sm:gap-14" aria-labelledby="hero-title" data-hero>
  <div class="flex-[1_1_560px] min-w-0 flex flex-col gap-8 sm:gap-9">
    <h1 id="hero-title" class="m-0 display text-[clamp(3.2rem,8vw,7.4rem)] leading-[0.88] tracking-[-0.05em]" data-hero-title>
      I speak both <span class="hl inline-block relative px-[0.1em] -rotate-2" data-hl><span class="absolute inset-0" aria-hidden="true"><span class="hl-smear slime-block absolute inset-0 rounded-[0.16em]" data-hl-smear></span><Drip class="absolute left-[20%] -bottom-[0.26em]" width={11} height={30} data-hl-drip /></span><span class="relative">tech</span></span> and people.
    </h1>
    <div class="flex flex-wrap gap-6 sm:gap-10 items-start" data-hero-copy>
      <p class="m-0 flex-[1_1_280px] max-w-[420px] text-[18px] leading-[1.55] text-ink-2">Engineer by training, designer by instinct. I design and build products people actually use, from the first conversation to launch.</p>
      <div class="flex flex-col gap-1.5 text-[16px] font-semibold">
        <a href="mailto:palomagutric@gmail.com" class="link">palomagutric@gmail.com</a>
        <a href="https://www.linkedin.com/in/palomagtzr" class="link" rel="me">linkedin.com/in/palomagtzr</a>
      </div>
    </div>
  </div>
  <div class="flex-[1_1_400px] min-w-0 relative h-[clamp(420px,110vw,540px)] sm:h-[540px]" data-hero-art>
    <div class="absolute inset-[64px_0_0_48px] bg-slime blob" aria-hidden="true" data-hero-blob>
      <!-- Slime running down from the blob into the first project (scrubbed). -->
      <Drip class="absolute top-full left-[42%]" width={18} height={230} data-blob-drip />
      <Drip class="absolute top-full left-[60%]" width={14} height={150} data-blob-drip />
      <Drip class="absolute top-full left-[24%] hidden sm:block" width={12} height={100} data-blob-drip />
    </div>
    <div class="absolute top-0 left-0 w-[min(76%,430px)] h-[89%] max-h-[550px] sm:h-[480px]" data-hero-photo>
      <Image
        src={photo}
        alt="Paloma Gutiérrez Ricaud"
        widths={[430, 860]}
        sizes="(min-width: 1024px) 430px, 76vw"
        quality={90}
        class="w-full h-full object-cover object-[50%_20%] rounded-[28px] border-[1.5px] border-ink"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <DropLogo class="absolute right-[18px] bottom-[26px] w-[72px] h-[72px] sm:w-[104px] sm:h-[104px] rotate-[10deg] js-wobble" />
  </div>
</section>

<style>
  /* The blob is alive: a slow border-radius morph (one element, 12 s loop). */
  .blob {
    border-radius: 44px 44px 44px 6px;
    animation: blob 12s ease-in-out infinite;
  }
  @keyframes blob {
    0%, 100% { border-radius: 44px 44px 44px 6px; }
    30% { border-radius: 60px 38px 52px 10px; }
    60% { border-radius: 40px 64px 36px 6px; }
  }
  @media (prefers-reduced-motion: reduce) { .blob { animation: none; } }
</style>

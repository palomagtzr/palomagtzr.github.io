---
/** Browser-window frame around a screenshot; the frame takes the image's real aspect ratio. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  shadow?: boolean;
}
const { src, alt, sizes = '(min-width: 1024px) 600px, calc(100vw - 72px)', widths = [600, 900, 1200, 1555], class: cls = '', shadow = false } = Astro.props;
---
<div class:list={['browser w-full flex flex-col rounded-xl overflow-hidden border-[1.5px] border-ink bg-white', shadow && 'shadow-[0_24px_50px_rgba(20,20,20,0.25)]', cls]}>
  <div class="h-[30px] shrink-0 bg-ink flex items-center gap-[7px] px-3" aria-hidden="true">
    <span class="w-[9px] h-[9px] rounded-full bg-paper"></span>
    <span class="w-[9px] h-[9px] rounded-full bg-paper"></span>
    <span class="w-[9px] h-[9px] rounded-full bg-slime"></span>
  </div>
  <div class="relative overflow-hidden w-full" data-frame>
    <Image src={src} alt={alt} widths={widths} sizes={sizes} quality={92} class="w-full h-auto" loading="lazy" decoding="async" />
  </div>
</div>

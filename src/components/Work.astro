---
import { Image } from 'astro:assets';
import Browser from './Browser.astro';
import Drip from './Drip.astro';
import Counter from './Counter.astro';
import Pour from './Pour.astro';

const index = [
  ['01', 'ABR Tickets'],
  ['02', 'Construction finance platform'],
  ['03', 'ABR Operaciones'],
  ['04', 'A.R. Monex Pro Cycling Team'],
  ['05', 'ABR brand websites'],
  ['06', 'Process redesign'],
];
import ticketsWeb from '../assets/tickets_web.jpg';
import ticketsMobile from '../assets/tickets_mobile.jpg';
import finance from '../assets/finance.jpg';
import ops from '../assets/ops.jpg';
import monexLogo from '../assets/armonex-logo.png';
import abrHome from '../assets/abr_home.jpg';
import obraHome from '../assets/obra_home.jpg';

const departments = [
  { name: 'Operations', bars: [[2, true], [1, false], [3, false]] },
  { name: 'Purchasing', bars: [[1, false], [2, true], [2, false]] },
  { name: 'People', bars: [[3, false], [1, true], [1, false]] },
  { name: 'Accounting', bars: [[1, false], [1, false], [3, true]] },
] as const;
---
<section id="work" class="border-t-[1.5px] border-ink scroll-mt-20" aria-labelledby="work-title" data-section="work">
  <div class="container-x pt-8 sm:pt-12 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
    <div class="flex items-end gap-4 sm:gap-5">
      <h2 id="work-title" class="m-0 display text-[clamp(2.4rem,6vw,5.4rem)] tracking-[-0.045em] leading-[0.95] relative inline-block pr-[0.12em]">Selected work<Drip class="absolute right-[0.1em] -bottom-[0.3em]" width={13} height={50} data-title-drip /></h2>
      <span class="label text-ink-3 pb-[0.3em]">(06)</span>
    </div>
    <span class="label text-ink-3 pb-[0.3em]">2024 — 2026</span>
  </div>
  <div class="container-x pt-14 sm:pt-[72px] pb-10 flex gap-10">
  <nav class="hidden xl:block w-[170px] shrink-0" aria-label="Projects">
    <div class="sticky top-[120px] relative pl-6" data-index>
      <svg class="absolute left-0 top-0 w-[14px] h-[17px] overflow-visible" viewBox="-17 -20 34 42" aria-hidden="true" focusable="false" data-index-marker><use href="#slime-drop"></use></svg>
      <ol class="m-0 p-0 list-none">
        {index.map(([n, name]) => (
          <li><a href={`#project-${n}`} class="index-link label block py-1.5 no-underline text-ink-3 hover:text-ink" data-index-link={n}>{name}</a></li>
        ))}
      </ol>
    </div>
  </nav>
  <div class="flex-1 min-w-0 flex flex-col gap-20 sm:gap-[120px]">

    <article id="project-01" class="flex flex-wrap items-center gap-10 sm:gap-14 scroll-mt-24" data-project>
      <div class="panel flex-[1_1_600px] min-w-0 rounded-[36px] p-5 sm:p-11 flex min-h-[380px] sm:min-h-[480px] relative overflow-hidden" data-panel>
        <Pour color="#FFD23F" />
        <div class="relative z-10 flex-1 flex justify-center items-end gap-[22px]" data-panel-content>
        <div class="flex-auto max-w-[470px] bg-ink rounded-[14px] p-2 shadow-[0_24px_50px_rgba(20,20,20,0.22)] mr-[80px] sm:mr-0">
          <div class="relative overflow-hidden rounded-[7px]" data-frame>
            <Image src={ticketsWeb} alt="ABR Tickets board on web" widths={[800, 1200, 1600, 2400]} sizes="(min-width: 1024px) 470px, calc(100vw - 150px)" quality={90} class="w-full h-auto" loading="lazy" decoding="async" data-parallax />
          </div>
        </div>
        <div class="absolute right-5 bottom-5 w-[100px] sm:static sm:w-auto sm:flex-[0_0_150px] bg-ink rounded-[26px] p-[7px] shadow-[0_24px_50px_rgba(20,20,20,0.22)]">
          <div class="relative overflow-hidden rounded-[20px]" data-frame>
            <Image src={ticketsMobile} alt="ABR Tickets ticket detail on Android" widths={[300, 600, 700]} sizes="150px" quality={90} class="w-full h-auto" loading="lazy" decoding="async" data-parallax />
          </div>
        </div>
        </div>
      </div>
      <div class="flex-[1_1_320px] min-w-0 flex flex-col gap-[18px]" data-project-copy>
        <Counter value="01" class="text-[64px] sm:text-[72px]" />
        <h3 class="m-0 display text-[36px] sm:text-[44px] tracking-[-0.035em] leading-none"><span class="sr-only">Project 01: </span>ABR Tickets</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">Replaced a paid ticketing tool the team had outgrown. Five user roles, six ticket states, automatic SLA tracking, client sign-off and PDF/Excel exports, on web and Android.</p>
        <p class="m-0 label text-ink-3 leading-[1.8]">Product owner / UX &amp; UI / Sole developer<br />Web + Android · Internal tool · Shown with sample data</p>
      </div>
    </article>

    <article id="project-02" class="flex flex-wrap-reverse items-center gap-10 sm:gap-14 scroll-mt-24" data-project>
      <div class="flex-[1_1_320px] min-w-0 flex flex-col gap-[18px]" data-project-copy>
        <Counter value="02" class="text-[64px] sm:text-[72px]" />
        <h3 class="m-0 display text-[36px] sm:text-[44px] tracking-[-0.035em] leading-none"><span class="sr-only">Project 02: </span>Construction finance platform</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">One source of truth for 25+ construction projects that used to live in spreadsheets: role-based access, bulk Excel import, reports, and a data migration verified to the cent.</p>
        <p class="m-0 label text-ink-3 leading-[1.8]">Product owner / Data model / Developer<br />Web · Internal tool · Shown with sample data</p>
      </div>
      <div class="panel flex-[1_1_600px] min-w-0 rounded-[36px] p-5 sm:p-11 flex min-h-[380px] sm:min-h-[480px] relative overflow-hidden" data-panel>
        <Pour color="#141414" />
        <div class="relative z-10 flex-1 flex justify-center items-end" data-panel-content>
          <div class="w-full max-w-[600px]"><Browser src={finance} alt="Project finance dashboard" /></div>
        </div>
      </div>
    </article>

    <article id="project-03" class="flex flex-wrap items-center gap-10 sm:gap-14 scroll-mt-24" data-project>
      <div class="panel flex-[1_1_600px] min-w-0 rounded-[36px] border-[1.5px] border-ink p-5 sm:p-11 flex min-h-[380px] sm:min-h-[480px] relative overflow-hidden" data-panel>
        <Pour color="#FFFFFF" />
        <div class="relative z-10 flex-1 flex justify-center items-end" data-panel-content>
          <div class="w-full max-w-[600px]"><Browser src={ops} alt="Visit schedule dashboard" /></div>
        </div>
      </div>
      <div class="flex-[1_1_320px] min-w-0 flex flex-col gap-[18px]" data-project-copy>
        <Counter value="03" class="text-[64px] sm:text-[72px]" />
        <h3 class="m-0 display text-[36px] sm:text-[44px] tracking-[-0.035em] leading-none"><span class="sr-only">Project 03: </span>ABR Operaciones</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">Monthly visit schedules, preventive maintenance and photo evidence for every branch of a facilities contract, so coordinators validate work instead of chasing it.</p>
        <p class="m-0 label text-ink-3 leading-[1.8]">Product owner / UX &amp; UI / Sole developer<br />Web · Internal tool · Launching Dec 2026 · Shown with sample data</p>
      </div>
    </article>

    <article id="project-04" class="flex flex-wrap-reverse items-center gap-10 sm:gap-14 scroll-mt-24" data-project>
      <div class="flex-[1_1_320px] min-w-0 flex flex-col gap-[18px]" data-project-copy>
        <Counter value="04" class="text-[64px] sm:text-[72px]" />
        <h3 class="m-0 display text-[36px] sm:text-[44px] tracking-[-0.035em] leading-none"><span class="sr-only">Project 04: </span>A.R. Monex Pro Cycling Team</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">The only Mexican pro cycling team racing in Europe. I built the membership checkout behind their existing site: Stripe payments routed to the right legal entity and e-invoices issued automatically.</p>
        <p class="m-0 label text-ink-3 leading-[1.8]">Freelance / Checkout, payments &amp; invoicing<br />Site design by the team's previous studio</p>
        <a href="https://arprocycling.com" class="link text-[16px] self-start">arprocycling.com</a>
      </div>
      <div class="panel flex-[1_1_600px] min-w-0 rounded-[36px] border-[1.5px] border-ink p-5 sm:p-11 flex min-h-[380px] sm:min-h-[480px] relative overflow-hidden" data-panel>
        <Pour color="#FFFFFF" />
        <div class="relative z-10 flex-1 flex justify-center items-center" data-panel-content>
          <Image src={monexLogo} alt="A.R. Monex Pro Cycling Team logo" widths={[400, 800, 1207]} sizes="(min-width: 1024px) 330px, 55vw" quality={90} class="w-[55%] h-auto" loading="lazy" decoding="async" />
        </div>
      </div>
    </article>

    <article id="project-05" class="flex flex-wrap items-center gap-10 sm:gap-14 scroll-mt-24" data-project>
      <div class="panel flex-[1_1_600px] min-w-0 rounded-[36px] p-5 sm:p-11 flex min-h-[380px] sm:min-h-[480px] relative overflow-hidden" data-panel>
        <Pour color="#FFD23F" />
        <div class="relative z-10 flex-1 flex justify-center items-end" data-panel-content>
        <div class="relative w-full max-w-[600px] h-[260px] sm:h-[420px]">
          <div class="absolute left-0 top-0 w-[78%]" data-window="back">
            <Browser src={abrHome} alt="somosabr.com.mx homepage" sizes="(min-width: 1024px) 470px, 70vw" />
          </div>
          <div class="absolute right-0 bottom-0 w-[66%]" data-window="front">
            <Browser src={obraHome} alt="obra.somosabr.com.mx homepage" sizes="(min-width: 1024px) 400px, 60vw" shadow />
          </div>
        </div>
        </div>
      </div>
      <div class="flex-[1_1_320px] min-w-0 flex flex-col gap-[18px]" data-project-copy>
        <Counter value="05" class="text-[64px] sm:text-[72px]" />
        <h3 class="m-0 display text-[36px] sm:text-[44px] tracking-[-0.035em] leading-none"><span class="sr-only">Project 05: </span>ABR brand websites</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-2">Two sites for a maintenance and construction group that looks after brands like Soho House and Tim Hortons across 11 Mexican states.</p>
        <p class="m-0 label text-ink-3 leading-[1.8]">Design / Development / SEO</p>
        <div class="flex flex-wrap gap-5"><a href="https://somosabr.com.mx" class="link text-[16px]">somosabr.com.mx</a><a href="https://obra.somosabr.com.mx" class="link text-[16px]">obra.somosabr.com.mx</a></div>
      </div>
    </article>

    <article id="project-06" class="panel rounded-[36px] text-paper p-7 sm:px-11 sm:py-14 flex flex-wrap gap-10 sm:gap-14 items-center relative overflow-hidden" data-project data-panel>
      <Pour color="#141414" />
      <div class="relative z-10 flex-[1_1_320px] min-w-0 flex flex-col gap-[18px]" data-project-copy>
        <Counter value="06" class="text-[64px] sm:text-[72px]" />
        <h3 class="m-0 display text-[36px] sm:text-[44px] tracking-[-0.035em] leading-none"><span class="sr-only">Project 06: </span>Process redesign</h3>
        <p class="m-0 text-[17px] leading-[1.55] text-ink-soft">Co-led the diagnosis of how four departments in a group of 200+ people really work, before deciding where technology should help.</p>
      </div>
      <div class="relative z-10 flex-[1_1_520px] min-w-0 flex flex-col gap-3" aria-hidden="true" data-bars data-panel-content>
        {departments.map((d) => (
          <div class="flex items-center gap-3.5">
            <span class="flex-[0_0_84px] sm:flex-[0_0_108px] label text-ink-soft">{d.name}</span>
            <div class="flex-1 h-[42px] rounded-[10px] bg-[#2A2A2A] flex gap-2 p-1.5">
              {d.bars.map(([flex, lit]) => (
                <span class:list={['rounded-md', lit ? 'bg-paper' : 'bg-[#4A4A4A]']} style={`flex:${flex}`} data-bar></span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </article>
  </div>
  </div>
  <!-- Work drips over the next section: a slime band with a wavy edge and three scrubbed drips. -->
  <div class="relative mt-16 sm:mt-24 h-10 sm:h-14 bg-linear-to-b from-slime to-amber" aria-hidden="true" data-band>
    <svg class="absolute left-0 right-0 top-full w-full h-[26px] sm:h-[36px] block" viewBox="0 0 1440 36" preserveAspectRatio="none" focusable="false">
      <path d="M0 0 L1440 0 L1440 10 C1380 10 1360 30 1290 28 C1220 26 1200 6 1130 8 C1060 10 1040 32 970 30 C900 28 880 4 810 6 C740 8 720 34 650 32 C580 30 560 8 490 10 C420 12 400 30 330 28 C260 26 240 6 170 8 C100 10 60 20 0 14 Z" fill="#E0A100"></path>
    </svg>
    <Drip class="absolute top-full left-[18%]" width={16} height={120} data-band-drip />
    <Drip class="absolute top-full left-[52%]" width={12} height={80} data-band-drip />
    <Drip class="absolute top-full left-[79%]" width={18} height={150} data-band-drip />
  </div>
</section>

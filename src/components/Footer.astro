---
import { Image } from 'astro:assets';
import wordmark from '../assets/paloma_slime.png';
---
<footer id="contact" class="bg-paper overflow-hidden scroll-mt-20" aria-labelledby="contact-title" data-section="contact">
  <div class="container-x pt-10 flex flex-wrap justify-between gap-6 label leading-[1.6]">
    <h2 id="contact-title" class="m-0 font-semibold label">Let's build something<br />people love using</h2>
    <span><a href="mailto:palomagutric@gmail.com" class="no-underline font-semibold">Email</a><br /><a href="https://www.linkedin.com/in/palomagtzr" class="no-underline font-semibold" rel="me">LinkedIn</a><br /><a href="/cv.pdf" download="CV_Paloma_Gutierrez_Ricaud.pdf" class="no-underline font-semibold">Download CV</a></span>
  </div>
  <div class="px-4 sm:px-6 pt-8 flex justify-center">
    <div class="relative w-full max-w-[1560px]" data-wordmark>
      <Image src={wordmark} alt="Paloma" widths={[640, 1000, 1560, 1800]} sizes="(min-width: 1600px) 1560px, calc(100vw - 48px)" class="w-full h-auto" loading="lazy" decoding="async" data-wordmark-img />
      <svg class="absolute top-0 left-0 w-full h-auto pointer-events-none overflow-visible" viewBox="0 0 1800 504" aria-hidden="true" focusable="false" data-drips></svg>
    </div>
  </div>
  <div class="container-x pt-4 pb-7 flex flex-wrap justify-between gap-4 label text-ink-3">
    <span>© 2026 Paloma Gutiérrez Ricaud</span>
    <span>Mexico City / Barcelona</span>
    <span>Spanish · English</span>
  </div>
</footer>

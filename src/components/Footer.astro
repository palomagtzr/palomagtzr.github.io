---
/**
 * Footer wordmark: "@PALOMAGTZR" built as clean vector at build time
 * (scripts/build-wordmark.mjs) and inlined so its layers can move
 * (#wm-ink letters, #wm-slime slime with hanging drips, #wm-gloss shine).
 * Drops that fall from the drips are added by footer.ts in the same viewBox.
 */
import paths from '../assets/palomagtzr_wordmark.inline.svg?raw';
import wordmark from '../data/wordmark.json';
---
<footer id="contact" class="bg-paper overflow-hidden scroll-mt-20" aria-labelledby="contact-title" data-section="contact">
  <div class="container-x pt-10 flex flex-wrap justify-between gap-6 label leading-[1.6]">
    <h2 id="contact-title" class="m-0 font-semibold label">Let's build something<br />people love using</h2>
    <div class="flex flex-col items-start -my-1"><a href="mailto:palomagutric@gmail.com" class="no-underline font-semibold py-1">Email</a><a href="https://www.linkedin.com/in/palomagtzr" class="no-underline font-semibold py-1" rel="me">LinkedIn</a><a href="/cv.pdf" download="CV_Paloma_Gutierrez_Ricaud.pdf" class="no-underline font-semibold py-1">Download CV</a></div>
  </div>
  <div class="px-4 sm:px-6 pt-8 flex justify-center">
    <a href="https://www.linkedin.com/in/palomagtzr" class="block w-full max-w-[1560px] pb-[6%] no-underline rounded-lg" aria-label="@palomagtzr on LinkedIn" rel="me" data-wordmark>
      <svg class="block w-full h-auto overflow-visible" viewBox={wordmark.viewBox} aria-hidden="true" focusable="false" data-wm-svg>
        <Fragment set:html={paths} />
        <g data-wm-drops></g>
      </svg>
    </a>
  </div>
  <div class="container-x pt-2 pb-7 flex flex-wrap justify-between gap-4 label text-ink-3">
    <span>© 2026 Paloma Gutiérrez Ricaud</span>
    <span>Mexico City / Barcelona</span>
    <span>Spanish · English</span>
  </div>
</footer>

---
/**
 * Shared SVG defs for the cartoon-gloss slime: a fixed gradient, a drop and a
 * stretchable drip. No filters anywhere — only paths, so every drip animates on
 * the compositor with transform/opacity.
 */
---
<svg class="absolute w-0 h-0 overflow-hidden" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="slime-grad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0.1" stop-color="#FFD23F"></stop>
      <stop offset="1" stop-color="#E0A100"></stop>
    </linearGradient>
    <!-- Round drop, 32×40 box centred on x=0 -->
    <symbol id="slime-drop" viewBox="-17 -20 34 42" overflow="visible">
      <path d="M0 -18 C7 -9 15 0 15 8 A15 15 0 1 1 -15 8 C-15 0 -7 -9 0 -18Z" fill="#B87F00" fill-opacity="0.4" transform="translate(0 2.5)"></path>
      <path d="M0 -18 C7 -9 15 0 15 8 A15 15 0 1 1 -15 8 C-15 0 -7 -9 0 -18Z" fill="url(#slime-grad)"></path>
      <path d="M-7.5 2 C-7.5 -3 -4.5 -7 -1.5 -9.5" fill="none" stroke="#FFFFFF" stroke-opacity="0.85" stroke-width="3" stroke-linecap="round"></path>
    </symbol>
    <!-- Hanging drip: thin neck from the top, bulb at the bottom. Scale it on Y from the top to stretch. -->
    <symbol id="slime-drip" viewBox="-16 0 32 100" overflow="visible">
      <path d="M-6 0 L6 0 C6 30 8 56 12 72 C15 82 15 100 0 100 C-15 100 -15 82 -12 72 C-8 56 -6 30 -6 0Z" fill="#B87F00" fill-opacity="0.4" transform="translate(0 2.5)"></path>
      <path d="M-6 0 L6 0 C6 30 8 56 12 72 C15 82 15 100 0 100 C-15 100 -15 82 -12 72 C-8 56 -6 30 -6 0Z" fill="url(#slime-grad)"></path>
      <path d="M-5 78 C-6 72 -5 66 -3 60" fill="none" stroke="#FFFFFF" stroke-opacity="0.8" stroke-width="2.5" stroke-linecap="round"></path>
    </symbol>
  </defs>
</svg>

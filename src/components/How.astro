---
import DropLogo from './DropLogo.astro';
const word = 'display text-[clamp(4rem,12vw,11rem)] leading-[0.82] tracking-[-0.06em]';
---
<section id="how" class="overflow-x-clip scroll-mt-20" aria-labelledby="how-title" data-section="how">
  <div class="container-x pt-24 pb-24 sm:pt-[120px] sm:pb-[110px] flex flex-col">
  <div class="flex justify-between gap-4 pb-7 label">
    <h2 id="how-title" class="m-0 font-semibold label">How I work</h2>
    <span class="text-ink-3">Three habits</span>
  </div>

  <div class="flex flex-wrap items-end gap-x-10 gap-y-4 py-7 border-t-[1.5px] border-ink" data-habit="left">
    <span class="label text-ink-3 self-start pt-[18px]" aria-hidden="true">(1)</span>
    <span class={word} data-word>Listen.</span>
    <p class="m-0 mb-2.5 flex-[1_1_240px] max-w-[320px] text-[18px] leading-[1.5] text-ink-2" data-habit-copy>I don't build until I understand how the work actually happens.</p>
  </div>

  <div class="flex flex-wrap-reverse items-end justify-end gap-x-10 gap-y-4 py-7 border-t-[1.5px] border-ink" data-habit="right">
    <p class="m-0 mb-2.5 flex-[1_1_240px] max-w-[320px] text-[18px] leading-[1.5] text-ink-2 text-right" data-habit-copy>If people don't enjoy using it, it doesn't matter how well it works.</p>
    <span class={`${word} inline-flex items-start gap-[0.08em]`}>
      <span class="relative inline-block px-[0.12em] pt-[0.04em] pb-[0.1em] rounded-[0.14em] -rotate-2" data-design>
        <span class="absolute inset-0 rounded-[0.14em] bg-slime" aria-hidden="true" data-design-smear></span>
        <span class="relative" data-word>Design.</span>
      </span>
      <DropLogo class="w-[0.42em] h-[0.42em] rotate-[12deg] shrink-0" />
    </span>
    <span class="label text-ink-3 self-start pt-[18px]" aria-hidden="true">(2)</span>
  </div>

  <div class="flex flex-wrap items-end gap-x-10 gap-y-4 pt-7 pl-[clamp(0px,8vw,140px)] border-t-[1.5px] border-ink" data-habit="left">
    <span class="label text-ink-3 self-start pt-[18px]" aria-hidden="true">(3)</span>
    <span class={word} data-word>Write it down.</span>
    <p class="m-0 mb-2.5 flex-[1_1_240px] max-w-[320px] text-[18px] leading-[1.5] text-ink-2" data-habit-copy>Specs and decisions go on paper, so nothing lives only in my head.</p>
  </div>
  </div>
</section>

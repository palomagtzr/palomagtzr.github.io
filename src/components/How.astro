---
import DropLogo from './DropLogo.astro';
const word = 'display leading-[0.82] tracking-[-0.06em] whitespace-nowrap';
const num = 'label text-ink-3 w-9 shrink-0 pt-[18px]';
---
<section id="how" class="overflow-x-clip scroll-mt-20" aria-labelledby="how-title" data-section="how">
  <div class="container-x pt-28 pb-24 sm:pt-[140px] sm:pb-[110px] flex flex-col">
  <div class="flex justify-between gap-4 pb-7 label">
    <h2 id="how-title" class="m-0 font-semibold label">How I work</h2>
    <span class="text-ink-3">Three habits</span>
  </div>

  <div class="flex items-start gap-x-4 sm:gap-x-6 py-7 border-t-[1.5px] border-ink" data-habit="left">
    <span class={num} aria-hidden="true">(1)</span>
    <div class="min-w-0 flex-1 flex flex-wrap items-end gap-x-10 gap-y-4">
      <h3 class={`m-0 ${word} text-[clamp(4rem,12vw,11rem)]`} data-word>Map.</h3>
      <p class="m-0 mb-2.5 flex-[1_1_240px] max-w-[320px] text-[18px] leading-[1.5] text-ink-2" data-habit-copy>People, processes and pain points first. The real problem is rarely the first one you hear.</p>
    </div>
  </div>

  <div class="flex items-start justify-end gap-x-4 sm:gap-x-6 py-7 border-t-[1.5px] border-ink" data-habit="right">
    <div class="min-w-0 flex-1 flex flex-wrap-reverse items-end justify-end gap-x-10 gap-y-4">
      <p class="m-0 mb-2.5 flex-[1_1_240px] max-w-[320px] text-[18px] leading-[1.5] text-ink-2 text-right" data-habit-copy>Interfaces that feel effortless on top of systems that don't break: the part people see and the parts nobody does.</p>
      <div class={`${word} text-[clamp(4rem,12vw,11rem)] inline-flex items-start gap-[0.08em]`}>
        <div class="relative inline-block px-[0.12em] pt-[0.04em] pb-[0.1em] rounded-[0.14em] -rotate-2" data-design>
          <span class="slime-block absolute inset-0 rounded-[0.14em]" aria-hidden="true" data-design-smear></span>
          <h3 class="m-0 relative" data-word>Make.</h3>
        </div>
        <DropLogo class="w-[0.42em] h-[0.42em] rotate-[12deg] shrink-0" />
      </div>
    </div>
    <span class={`${num} text-right`} aria-hidden="true">(2)</span>
  </div>

  <div class="flex items-start gap-x-4 sm:gap-x-6 pt-7 border-t-[1.5px] border-ink" data-habit="left">
    <span class={num} aria-hidden="true">(3)</span>
    <div class="min-w-0 flex-1 flex flex-wrap items-end gap-x-10 gap-y-4 sm:pl-[clamp(0px,6vw,120px)]">
      <h3 class={`m-0 ${word} text-[clamp(4rem,12vw,11rem)]`} data-word>Launch.</h3>
      <p class="m-0 mb-2.5 flex-[1_1_240px] max-w-[320px] text-[18px] leading-[1.5] text-ink-2" data-habit-copy>Every flow tested before it goes live, and refined once real people start using it.</p>
    </div>
  </div>
  </div>
</section>
